{
  "expo": {
    "name": "ZERO HOUR",
    "slug": "zero-hour-game",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/app/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/app/splash-icon.png",
