    "dev_only": false,
    "api_node": true,
    "price_badge": {
      "engine": "jsonata",
      "depends_on": {
        "widgets": [
          {
            "name": "model",
            "type": "COMFY_DYNAMICCOMBO_V3"
          },
          {
            "name": "size",
            "type": "COMFY_DYNAMICCOMBO_V3"
          },
          {
            "name": "size.width",
            "type": "INT"
          },
          {
            "name": "size.height",
            "type": "INT"
          },
          {
            "name": "n",
            "type": "INT"
          }
        ],
        "inputs": [],
        "input_groups": [
          "model.images"
        ]
      },
      "expr": "\n                (\n                  $isPro := widgets.model = \"qwen-image-3.0-pro\";\n                  $mode := widgets.size;\n                  $count := $max([$lookup(inputGroups, \"model.images\"), 1]);\n                  $inputCost := 0.00429 * $count;\n                  $area := $mode = \"custom\"\n                    ? $lookup(widgets, \"size.width\") * $lookup(widgets, \"size.height\") : 0;\n                  $customRate := $area > 2250000 ? 0.10725 : 0.0572;\n                  $isPro and $mode != \"custom\"\n                    ? {\"type\":\"range_usd\",\n                       \"min_usd\": 0.0572 * widgets.n + $inputCost,\n                       \"max_usd\": 0.10725 * widgets.n + $inputCost}\n                    : {\"type\":\"usd\",\n                       \"usd\": ($isPro ? $customRate : 0.0429) * widgets.n + $inputCost}\n                )\n                "
    },
