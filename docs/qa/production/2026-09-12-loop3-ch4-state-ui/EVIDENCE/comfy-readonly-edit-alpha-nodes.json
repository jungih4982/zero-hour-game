    "name": "QwenImageEditApi",
    "display_name": "Qwen Image 3 Edit",
    "description": "Edits or combines up to 3 reference images guided by a text prompt using the Qwen-Image 3.0 models.",
    "python_module": "comfy_api_nodes.nodes_qwen",
    "category": "partner/image/Qwen",
    "output_node": false,
    "deprecated": false,
