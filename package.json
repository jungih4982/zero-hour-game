{
  "name": "zero-hour-game",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:narrative": "tsx scripts/run-narrative-simulation.ts",
    "test:dialogue": "tsx scripts/verify-dialogue-source.ts",
    "test:beats": "tsx scripts/test-dialogue-beats.ts",
    "test:duration": "tsx scripts/measure-vertical-slice.ts",
    "test:layout": "tsx scripts/test-responsive-layout.ts",
    "test": "npm run typecheck && npm run test:dialogue && npm run test:beats && npm run test:narrative && npm run test:duration && npm run test:layout"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.36",
    "expo-av": "~16.0.8",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^1.32.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  },
  "private": true
